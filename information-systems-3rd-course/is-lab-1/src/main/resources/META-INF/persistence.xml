<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
    <persistence-unit name="routesPU" transaction-type="JTA">
        <jta-data-source>java:/jdbc/RouteDS</jta-data-source>
        <class>ru.itmo.routes.domain.Route</class>
        <class>ru.itmo.routes.domain.Location</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.jdbc.time_zone" value="Europe/Moscow"/>
        </properties>
    </persistence-unit>
</persistence>

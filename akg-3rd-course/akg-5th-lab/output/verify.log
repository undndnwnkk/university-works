== 2. Яркость: сравнение с аналитическим расчётом
Точечный ламбертовский источник I0 = 10 Вт/ср на высоте h = 2, kd = 0.5
  L = kd/pi * I0*cos(a) * cos(b) / r^2 = kd*I0*h^2 / (pi*r^4)
  пиксель    точка                         r    L аналит.   L трассир. отн. ошибка
  (250,250)  ( 0.007,  0.000,  0.009)   2.0000     0.397862     0.397862   6.98e-16
  (250,150)  ( 0.008,  0.000, -2.387)   3.1139    0.0677098    0.0677098   8.20e-16
  (100,250)  (-1.951,  0.000,  0.009)   2.7939     0.104485     0.104485   1.33e-16
  (400,400)  ( 1.459,  0.000,  2.063)   3.2228    0.0590154    0.0590154   3.53e-16
  (120,120)  (-2.414,  0.000, -3.413)   4.6343    0.0138022    0.0138022   5.03e-16
  (480,300)  ( 2.697,  0.000,  0.836)   3.4598    0.0444277    0.0444277   1.56e-16
  (250, 90)  ( 0.010,  0.000, -4.665)   5.0759   0.00959041   0.00959041   1.81e-16
Параллельный источник E0 = 3, направление (1,-2,0.5), Ламберт kd=0.5 + Блинн-Фонг ks=0.4, n=20
  L = (kd/pi + ks*(n+8)/(8pi)*cos^n(theta_h)) * E0 * cos(theta)
  (250,250) L аналит. = 0.655514, L трассир. = 0.655514, отн. ошибка 0.00e+00
  (250,150) L аналит. = 0.50262, L трассир. = 0.50262, отн. ошибка 2.21e-16
  (100,250) L аналит. = 0.909559, L трассир. = 0.909559, отн. ошибка 0.00e+00
  (400,400) L аналит. = 0.604621, L трассир. = 0.604621, отн. ошибка 0.00e+00


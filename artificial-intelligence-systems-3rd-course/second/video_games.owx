    <DLSafeRule>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="ru">Правило same_developer/2: разные игры одной студии.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#developedBy"/>
                <Variable IRI="#g1"/>
                <Variable IRI="#s"/>
            </ObjectPropertyAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#developedBy"/>
                <Variable IRI="#g2"/>
                <Variable IRI="#s"/>
            </ObjectPropertyAtom>
            <DifferentIndividualsAtom>
                <Variable IRI="#g1"/>
                <Variable IRI="#g2"/>
            </DifferentIndividualsAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#sameDeveloperAs"/>
                <Variable IRI="#g1"/>
                <Variable IRI="#g2"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
